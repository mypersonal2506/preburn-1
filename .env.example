# Release to run. Set a newer one to upgrade.
# x-release-please-start-version
PREBURN_VERSION=0.1.1
# x-release-please-end

# Port on 127.0.0.1 that serves the dashboard and the API.
PREBURN_PORT=8080

# Required key that encrypts stored secrets. Create it with: docker run --rm ghcr.io/preburn/preburn secret-key
PREBURN_SECRET_KEY=

# Postgres password, preburn when unset. Set one of letters and digits before exposing anything and before the first start.
# POSTGRES_PASSWORD=

# Address people and SDKs use to reach Preburn. Links start with it, and https turns on secure cookies.
PREBURN_PUBLIC_URL=http://localhost:8080

# Postgres connections each process keeps open.
PREBURN_DATABASE_MAXIMUM_CONNECTIONS=10

# Prefix of every Valkey key.
PREBURN_REDIS_KEY_PREFIX=preburn:

# Log level: debug, info, warn or error.
PREBURN_LOG_LEVEL=info

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
PREBURN_TRUSTED_PROXIES=

# Days decisions are kept.
PREBURN_DECISION_RETENTION_DAYS=90

# Refresh model prices from LiteLLM every day: true or false.
PREBURN_PRICING_LITELLM_REFRESH=false

# Let webhook endpoints resolve to private network addresses: true or false.
PREBURN_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# OTLP endpoint that receives traces, such as http://otel-collector:4318. Tracing is off while it is empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
